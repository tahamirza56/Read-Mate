# Copy this file to .streamlit/secrets.toml for local testing
# For Streamlit Cloud: paste contents into Settings → Secrets

GOOGLE_API_KEY = "your_gemini_api_key_here"

# Optional: Override defaults
GEMINI_MODEL = "gemini-3.6-flash"
GEMINI_EMBEDDING_MODEL = "models/gemini-embedding-001"
CHUNK_SIZE = "1000"
CHUNK_OVERLAP = "200"
TOP_K = "4"